generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Film {
  id              Int       @id
  name            String?
  alternativeName String?
  year            Int?
  description     String?
  posterUrl       String?
  posterPreview   String?
  ratingKp        Float?
  ratingImdb      Float?
  ratingVotes     Int?
  movieLength     Int?
  genres          String[]
  countries       String[]
  watched         Boolean   @default(false)
  watchedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SyncLog {
  id        Int      @id @default(autoincrement())
  status    String
  total     Int      @default(0)
  message   String?
  createdAt DateTime @default(now())
}
